{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@notes/*": ["src/renderer/src/features/notes/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["electron", "src", "vitest.config.ts", "electron.vite.config.ts"]
}
